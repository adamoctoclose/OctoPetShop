step "production-approval" {
    name = "Production Approval"

    action {
        action_type = "Octopus.Manual"
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "#{AppSettings:EnvironmentName}"
        }
    }
}

step "sql-create-database-user-if-not-exists" {
    name = "SQL - Create Database User If Not Exists"
    properties = {
        Octopus.Action.TargetRoles = "octopetshop-database"
    }

    action {
        properties = {
            createDatabaseName = "#{Project.Database.Name}"
            createSqlLoginPasswordWhoHasRights = "#{Project.Database.Password}"
            createSqlLoginUserWhoHasCreateUserRights = "#{Project.Database.User}"
            createSqlServer = "#{Project.Database.Server.Name}"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-31"
            Octopus.Action.Template.Version = "2"
        }
        worker_pool_variable = ""
    }
}

step "flyway-database-migrations" {
    name = "Flyway Database Migrations"
    properties = {
        Octopus.Action.TargetRoles = "octopetshop-database"
    }

    action {
        properties = {
            Flyway.Authentication.Method = "usernamepassword"
            Flyway.Command.BaseLineOnMigrate = "false"
            Flyway.Command.FailOnDrift = "true"
            Flyway.Command.Locations = "filesystem:C:\\scripts\\flyway\\sql"
            Flyway.Command.OutOfOrder = "false"
            Flyway.Command.SkipExecutingMigrations = "false"
            Flyway.Command.Target = "latest"
            Flyway.Command.Value = "migrate"
            Flyway.Database.User = "#{Project.Database.User}"
            Flyway.Database.User.Password = "#{Project.Database.Password}"
            Flyway.Package.Value = "{\"PackageId\":\"OctoPetShop.Database\",\"FeedId\":\"artifactory\"}"
            Flyway.Target.Url = "#{Project.Database.ConnectionString}"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-38"
            Octopus.Action.Template.Version = "15"
        }
        worker_pool_variable = ""

        packages "Flyway.Package.Value" {
            acquisition_location = "Server"
            feed = "artifactory"
            package_id = "OctoPetShop.Database"
            properties = {
                Extract = "True"
                PackageParameterName = "Flyway.Package.Value"
                SelectionMode = "deferred"
            }
        }
    }
}